version: v0.13.0

serve:
  public:
    base_url: __KRATOS_PUBLIC_BASE_URL__
    cors:
      enabled: true
      allowed_origins:
        - __KRATOS_UI_PUBLIC_URL__
        - __COACH_PUBLIC_URL__
  admin:
    base_url: __KRATOS_ADMIN_BASE_URL__

selfservice:
  default_browser_return_url: __KRATOS_UI_PUBLIC_URL__
  allowed_return_urls:
    - __KRATOS_ALLOWED_RETURN_URL_1__
    - __KRATOS_ALLOWED_RETURN_URL_2__
    - __KRATOS_ALLOWED_RETURN_URL_3__

  methods:
    password:
      enabled: true

  flows:
    error:
      ui_url: __KRATOS_UI_PUBLIC_URL__/error
    settings:
      ui_url: __KRATOS_UI_PUBLIC_URL__/settings
      privileged_session_max_age: 15m
    recovery:
      enabled: true
      ui_url: __KRATOS_UI_PUBLIC_URL__/recovery
      use: code
    verification:
      enabled: true
      ui_url: __KRATOS_UI_PUBLIC_URL__/verification
      use: code
      after:
        default_browser_return_url: __KRATOS_UI_PUBLIC_URL__/
    logout:
      after:
        default_browser_return_url: __KRATOS_UI_PUBLIC_URL__/login
    login:
      ui_url: __KRATOS_UI_PUBLIC_URL__/login
      lifespan: 10m
    registration:
      lifespan: 10m
      ui_url: __KRATOS_UI_PUBLIC_URL__/registration
      after:
        password:
          hooks:
            - hook: session
            - hook: show_verification_ui

log:
  level: info
  format: text

ciphers:
  algorithm: xchacha20-poly1305

hashers:
  algorithm: argon2
  argon2:
    memory: 128MB
    iterations: 2
    salt_length: 16
    key_length: 32
    expected_duration: 500ms
    expected_deviation: 500ms

identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/config/kratos/identity.schema.json

courier:
  smtp:
    connection_uri: __KRATOS_SMTP_CONNECTION_URI__

feature_flags:
  use_continue_with_transitions: true
