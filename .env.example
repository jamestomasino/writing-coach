COMPOSE_PROJECT_NAME=writing-coach

# Public deployment
COACH_PUBLIC_URL=https://coach.tomasino.org

WRITING_COACH_WRITER_NAME=Writer
WRITING_COACH_DEFAULT_USER_SLUG=default
WRITING_COACH_DEFAULT_TREE_SLUG=global-writing-skill-graph
WRITING_COACH_ADMIN_EMAILS=writer@example.com

# Localhost-only binding for host nginx.
WEB_PORT_BIND=127.0.0.1:11234:3000

# AI provider settings
# Optional shared system fallback for OpenAI-compatible generation.
# Leave OPENAI_API_KEY empty if you want all browser users to bring their own key.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Required when users save personal provider keys in the app.
# Use a long random secret and keep it stable across restarts.
WRITING_COACH_AI_KEY_SECRET=replace-with-a-long-random-secret
WRITING_COACH_PROMPT_MODEL=gpt-5-mini
WRITING_COACH_REVIEW_MODEL=gpt-5-mini

# Kratos secrets. Replace these in production.
KRATOS_COOKIE_SECRET=replace-with-a-long-random-secret
KRATOS_CIPHER_SECRET=replace-with-a-long-random-secret
KRATOS_UI_COOKIE_SECRET=replace-with-a-long-random-secret
KRATOS_UI_CSRF_SECRET=replace-with-a-long-random-secret

# Mail delivery for production. Example for Mailgun:
# KRATOS_SMTP_CONNECTION_URI=smtp://postmaster@mg.example.com:MAILGUN_SMTP_PASSWORD@smtp.mailgun.org:587/?skip_ssl_verify=false
KRATOS_SMTP_CONNECTION_URI=smtps://test:test@mailslurper:1025/?skip_ssl_verify=true
