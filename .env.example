COMPOSE_PROJECT_NAME=writing-coach

# Public deployment
COACH_PUBLIC_URL=https://coach.tomasino.org

WRITING_COACH_WRITER_NAME=Writer
WRITING_COACH_DEFAULT_USER_SLUG=default
WRITING_COACH_DEFAULT_TREE_SLUG=mythic-tragedy-apprenticeship
WRITING_COACH_ADMIN_EMAILS=writer@example.com

# Localhost-only bindings for host nginx upstreams.
APP_PORT_BIND=127.0.0.1:11234:8080
KRATOS_PUBLIC_PORT_BIND=127.0.0.1:14433:4433
KRATOS_UI_PORT_BIND=127.0.0.1:14455:3000

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
WRITING_COACH_PROMPT_MODEL=gpt-5-mini
WRITING_COACH_REVIEW_MODEL=gpt-5-mini

# Kratos secrets. Replace these in production.
KRATOS_COOKIE_SECRET=replace-with-a-long-random-secret
KRATOS_CIPHER_SECRET=replace-with-a-long-random-secret
KRATOS_UI_COOKIE_SECRET=replace-with-a-long-random-secret
KRATOS_UI_CSRF_SECRET=replace-with-a-long-random-secret

# Mail delivery for self-contained environments. Override for real SMTP later.
KRATOS_SMTP_CONNECTION_URI=smtps://test:test@mailslurper:1025/?skip_ssl_verify=true
