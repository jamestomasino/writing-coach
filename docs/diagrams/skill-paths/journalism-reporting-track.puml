@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam dpi 150
skinparam ArrowColor #5C6773
skinparam ArrowThickness 1.4
skinparam package {
  BorderColor #D5DCE3
  FontColor #2C3E50
  FontStyle bold
}
skinparam rectangle {
  RoundCorner 10
  BorderColor #5C6773
  FontColor #1F2933
}
