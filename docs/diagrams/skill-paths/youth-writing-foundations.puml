@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam dpi 150
skinparam ArrowColor #5C6773
skinparam ArrowThickness 1.4
skinparam package {
  BorderColor #D5DCE3
  FontColor #2C3E50
  FontStyle bold
}
skinparam rectangle {
  RoundCorner 10
  BorderColor #5C6773
  FontColor #1F2933
}
skinparam rectangle<<seed>> {
  BorderColor #A61E4D
  BorderThickness 3
}
hide stereotype

title Youth Writing Foundations\n<color:#5C6773>youth-writing-foundations</color>

legend left
|= Marker |= Meaning |
| thicker border | seed node |
|<back:#E3F2FD> foundation | stage |
|<back:#FFF8E1> paragraph | stage |
|<back:#FCE4EC> story | stage |
|<back:#F3E5F5> dialogue | stage |
|<back:#E0F7FA> forms | stage |
|<back:#ECEFF1> revision | stage |
endlegend

