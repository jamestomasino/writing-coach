@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam dpi 150
skinparam ArrowColor #5C6773
skinparam ArrowThickness 1.4
skinparam package {
  BorderColor #D5DCE3
  FontColor #2C3E50
  FontStyle bold
}
skinparam rectangle {
  RoundCorner 10
  BorderColor #5C6773
  FontColor #1F2933
}
skinparam rectangle<<seed>> {
  BorderColor #A61E4D
  BorderThickness 3
}
hide stereotype

title Persuasive Writing Track\n<color:#5C6773>persuasive-writing-track</color>

legend left
|= Marker |= Meaning |
| thicker border | seed node |
|<back:#E8F5E9> core | stage |
|<back:#E0F2F1> structure | stage |
|<back:#FFF3E0> appeal | stage |
|<back:#FFF3E0> objection | stage |
|<back:#E8F5E9> evidence | stage |
|<back:#F3E5F5> style | stage |
|<back:#EDE7F6> advanced | stage |
|<back:#ECEFF1> revision | stage |
endlegend

