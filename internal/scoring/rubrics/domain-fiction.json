{
  "id": "domain-fiction",
  "version": "det-v1",
  "domain": "fiction",
  "default_skills": ["narrative clarity", "scene architecture", "prose precision", "dialogue intelligence", "image freshness"],
  "default_skill_config": {
    "base_score": 3,
    "finding_penalty": 3,
    "max_finding_penalty": 2,
    "no_finding_bonus": 1,
    "range_rules": [
      {"metric": "avg_sentence_length", "min": 9, "max": 22, "delta": 1, "reason": "fiction sentence control band"},
      {"metric": "word_count", "min": 500, "max": 1200, "delta": 1, "reason": "scene development depth"}
    ],
    "category_penalties": {
      "clarity": 1,
      "readability": 1,
      "causal clarity": 1
    },
    "top_score_gate": {
      "require_no_findings": true,
      "min_metrics": {
        "word_count": 850,
        "nlp_unique_token_ratio": 55
      },
      "max_metrics": {
        "avg_sentence_length": 18,
        "nlp_readability_grade": 10,
        "nlp_passive_sentences": 0
      }
    }
  },
  "skills": {
    "narrative clarity": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "nlp_passive_sentences", "max": 1, "delta": 1, "reason": "clear actor/action line"},
        {"metric": "nlp_passive_sentences", "min": 4, "delta": -1, "reason": "agency blur through passive"},
        {"metric": "nlp_coref_ambiguity_count", "max": 1, "delta": 1, "reason": "character/action referents remain stable"},
        {"metric": "nlp_coref_ambiguity_count", "min": 3, "delta": -1, "reason": "referent ambiguity blurs narrative line"}
      ],
      "category_penalties": {
        "causal clarity": 1,
        "referent clarity": 1,
        "clarity": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 850
        },
        "max_metrics": {
          "nlp_passive_sentences": 0
        }
      }
    },
    "scene architecture": {
      "base_score": 3,
      "finding_penalty": 4,
      "max_finding_penalty": 2,
      "no_finding_bonus": 0,
      "range_rules": [
        {"metric": "paragraph_count", "min": 3, "delta": 1, "reason": "scene chunking present"},
        {"metric": "word_count", "min": 550, "delta": 1, "reason": "scene has sufficient beats"},
        {"metric": "word_count", "max": 220, "delta": -1, "reason": "scene underdeveloped"},
        {"metric": "nlp_topic_drift_score", "max": 45, "delta": 1, "reason": "scene focus stays coherent"},
        {"metric": "nlp_topic_drift_score", "min": 70, "delta": -1, "reason": "topic drift weakens beat progression"}
      ],
      "category_penalties": {
        "scene architecture": 1,
        "structure": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 900,
          "paragraph_count": 6
        }
      }
    },
    "prose precision": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "adverb_count", "max": 8, "delta": 1, "reason": "modifier discipline"},
        {"metric": "adverb_count", "min": 16, "delta": -1, "reason": "modifier overuse"},
        {"metric": "nlp_semantic_repetition_ratio", "max": 35, "delta": 1, "reason": "line-level repetition is controlled"},
        {"metric": "nlp_semantic_repetition_ratio", "min": 60, "delta": -1, "reason": "semantic repetition flattens prose"}
      ],
      "category_penalties": {
        "prose precision": 1,
        "diction variety": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 850,
          "nlp_unique_token_ratio": 54
        },
        "max_metrics": {
          "adverb_count": 5,
          "nlp_passive_sentences": 0
        }
      }
    },
    "dialogue intelligence": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "avg_sentence_length", "min": 9, "max": 17, "delta": 1, "reason": "dialogue cadence remains readable"},
        {"metric": "nlp_readability_grade", "max": 10, "delta": 1, "reason": "dialogue intent remains legible"}
      ],
      "category_penalties": {
        "clarity": 1,
        "referent clarity": 1,
        "sentence control": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 850
        },
        "max_metrics": {
          "avg_sentence_length": 15,
          "nlp_passive_sentences": 0
        }
      }
    },
    "image freshness": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "nlp_unique_token_ratio", "min": 46, "delta": 1, "reason": "lexical freshness supports vivid imagery"},
        {"metric": "adverb_count", "max": 7, "delta": 1, "reason": "imagery relies on specific nouns/verbs"}
      ],
      "category_penalties": {
        "diction variety": 1,
        "prose precision": 1,
        "readability": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "nlp_unique_token_ratio": 57
        },
        "max_metrics": {
          "adverb_count": 4
        }
      }
    }
  },
  "track_overrides": {
    "memoir-personal-narrative-track": {
      "add_skills": ["clarity and coherence"],
      "remove_skills": [],
      "skill_adjustments": {"narrative clarity": 1}
    }
  }
}
