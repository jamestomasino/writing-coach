{
  "id": "domain-general",
  "version": "det-v1",
  "domain": "general",
  "default_skills": ["clarity and coherence", "sentence economy"],
  "default_skill_config": {
    "base_score": 3,
    "finding_penalty": 3,
    "max_finding_penalty": 2,
    "no_finding_bonus": 1,
    "range_rules": [
      {"metric": "avg_sentence_length", "min": 10, "max": 22, "delta": 1, "reason": "sentence length in control band"},
      {"metric": "avg_sentence_length", "min": 28, "delta": -1, "reason": "overlong sentence average"},
      {"metric": "word_count", "max": 119, "delta": -1, "reason": "insufficient development length"}
    ],
    "category_penalties": {
      "clarity": 1,
      "readability": 1,
      "sentence control": 1,
      "causal clarity": 1
    },
    "top_score_gate": {
      "require_no_findings": true,
      "min_metrics": {
        "word_count": 450,
        "paragraph_count": 5
      },
      "max_metrics": {
        "avg_sentence_length": 16,
        "nlp_readability_grade": 9,
        "nlp_passive_sentences": 0
      }
    }
  },
  "skills": {
    "clarity and coherence": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "avg_sentence_length", "min": 10, "max": 22, "delta": 1, "reason": "clarity sentence range"},
        {"metric": "avg_sentence_length", "min": 28, "delta": -1, "reason": "clarity sentence overload"},
        {"metric": "nlp_readability_grade", "max": 10, "delta": 1, "reason": "accessible readability"},
        {"metric": "nlp_coref_ambiguity_count", "max": 1, "delta": 1, "reason": "referents stay clear"},
        {"metric": "nlp_coref_ambiguity_count", "min": 3, "delta": -1, "reason": "referent ambiguity weakens coherence"}
      ],
      "category_penalties": {
        "clarity": 1,
        "readability": 1,
        "referent clarity": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 500
        },
        "max_metrics": {
          "avg_sentence_length": 15,
          "nlp_passive_sentences": 0
        }
      }
    },
    "sentence economy": {
      "base_score": 3,
      "finding_penalty": 2,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "avg_sentence_length", "max": 24, "delta": 1, "reason": "sentence economy in range"},
        {"metric": "adverb_count", "max": 6, "delta": 1, "reason": "controlled modifier load"},
        {"metric": "adverb_count", "min": 14, "delta": -1, "reason": "high modifier load"},
        {"metric": "nlp_semantic_repetition_ratio", "max": 35, "delta": 1, "reason": "limited semantic repetition"},
        {"metric": "nlp_semantic_repetition_ratio", "min": 60, "delta": -1, "reason": "semantic repetition reduces economy"}
      ],
      "category_penalties": {
        "prose precision": 1,
        "sentence control": 1,
        "readability": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "max_metrics": {
          "avg_sentence_length": 14,
          "adverb_count": 3
        }
      }
    }
  },
  "track_overrides": {}
}
