{
  "id": "domain-professional",
  "version": "det-v1",
  "domain": "professional",
  "default_skills": ["clarity and coherence", "audience alignment", "actionability", "tone calibration", "sentence economy"],
  "default_skill_config": {
    "base_score": 3,
    "finding_penalty": 3,
    "max_finding_penalty": 2,
    "no_finding_bonus": 1,
    "range_rules": [
      {"metric": "avg_sentence_length", "min": 9, "max": 20, "delta": 1, "reason": "professional sentence control"},
      {"metric": "nlp_readability_grade", "max": 11, "delta": 1, "reason": "professional readability"},
      {"metric": "nlp_coref_ambiguity_count", "max": 1, "delta": 1, "reason": "ownership and referents stay explicit"},
      {"metric": "nlp_coref_ambiguity_count", "min": 3, "delta": -1, "reason": "referent ambiguity weakens accountability"},
      {"metric": "nlp_semantic_repetition_ratio", "max": 35, "delta": 1, "reason": "messages avoid redundant phrasing"},
      {"metric": "nlp_semantic_repetition_ratio", "min": 60, "delta": -1, "reason": "semantic repetition lowers efficiency"}
    ],
    "category_penalties": {
      "clarity": 1,
      "readability": 1,
      "sentence control": 1,
      "completeness": 1
    },
    "top_score_gate": {
      "require_no_findings": true,
      "min_metrics": {
        "word_count": 520,
        "paragraph_count": 6
      },
      "max_metrics": {
        "avg_sentence_length": 16,
        "nlp_readability_grade": 9,
        "nlp_passive_sentences": 0
      }
    }
  },
  "skills": {
    "actionability": {
      "base_score": 3,
      "finding_penalty": 2,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "word_count", "min": 220, "delta": 1, "reason": "sufficient operational detail"},
        {"metric": "nlp_passive_sentences", "max": 2, "delta": 1, "reason": "ownership-preserving phrasing"},
        {"metric": "nlp_claim_evidence_coverage", "min": 55, "delta": 1, "reason": "recommendations are justified"},
        {"metric": "nlp_claim_evidence_coverage", "max": 30, "delta": -1, "reason": "recommendations lack explicit rationale"}
      ],
      "category_penalties": {
        "causal clarity": 1,
        "clarity": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 560,
          "paragraph_count": 7
        },
        "max_metrics": {
          "avg_sentence_length": 15,
          "nlp_passive_sentences": 0
        }
      }
    }
  },
  "track_overrides": {
    "grant-writing-track": {
      "add_skills": ["evidence integration"],
      "remove_skills": [],
      "skill_adjustments": {"actionability": -1, "evidence integration": 1}
    }
  }
}
