{
  "id": "domain-professional",
  "version": "det-v1",
  "domain": "professional",
  "default_skills": ["clarity and coherence", "audience alignment", "actionability", "tone calibration", "sentence economy"],
  "default_skill_config": {
    "base_score": 3,
    "finding_penalty": 3,
    "max_finding_penalty": 2,
    "no_finding_bonus": 1,
    "range_rules": [
      {"metric": "avg_sentence_length", "min": 9, "max": 20, "delta": 1, "reason": "professional sentence control"},
      {"metric": "nlp_readability_grade", "max": 11, "delta": 1, "reason": "professional readability"}
    ],
    "category_penalties": {
      "clarity": 1,
      "readability": 1,
      "sentence control": 1,
      "completeness": 1
    }
  },
  "skills": {
    "actionability": {
      "base_score": 3,
      "finding_penalty": 2,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "word_count", "min": 220, "delta": 1, "reason": "sufficient operational detail"},
        {"metric": "nlp_passive_sentences", "max": 2, "delta": 1, "reason": "ownership-preserving phrasing"}
      ],
      "category_penalties": {
        "causal clarity": 1,
        "clarity": 1
      }
    }
  },
  "track_overrides": {
    "grant-writing-track": {
      "add_skills": ["evidence integration"],
      "remove_skills": [],
      "skill_adjustments": {"actionability": -1, "evidence integration": 1}
    }
  }
}
