{
  "id": "domain-academic",
  "version": "det-v1",
  "domain": "academic",
  "default_skills": ["claim clarity", "evidence integration", "clarity and coherence", "sentence economy"],
  "default_skill_config": {
    "base_score": 3,
    "finding_penalty": 3,
    "max_finding_penalty": 2,
    "no_finding_bonus": 1,
    "range_rules": [
      {"metric": "word_count", "min": 320, "delta": 1, "reason": "argument development threshold"},
      {"metric": "nlp_readability_grade", "max": 12, "delta": 1, "reason": "argument legibility"}
    ],
    "category_penalties": {
      "clarity": 1,
      "readability": 1,
      "sentence control": 1,
      "development": 1
    },
    "top_score_gate": {
      "require_no_findings": true,
      "min_metrics": {
        "word_count": 700,
        "nlp_unique_token_ratio": 56
      },
      "max_metrics": {
        "avg_sentence_length": 17,
        "nlp_readability_grade": 9,
        "nlp_passive_sentences": 0
      }
    }
  },
  "skills": {
    "claim clarity": {
      "base_score": 3,
      "finding_penalty": 2,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "nlp_passive_sentences", "max": 1, "delta": 1, "reason": "clear claim agency"},
        {"metric": "avg_sentence_length", "max": 24, "delta": 1, "reason": "claim readability control"},
        {"metric": "nlp_claim_evidence_coverage", "min": 60, "delta": 1, "reason": "claim-evidence coverage strong"},
        {"metric": "nlp_claim_evidence_coverage", "max": 35, "delta": -1, "reason": "claim-evidence coverage weak"}
      ],
      "category_penalties": {
        "clarity": 1,
        "causal clarity": 1,
        "referent clarity": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "max_metrics": {
          "nlp_passive_sentences": 0,
          "avg_sentence_length": 18
        }
      }
    },
    "evidence integration": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 0,
      "range_rules": [
        {"metric": "word_count", "min": 380, "delta": 1, "reason": "space for support and interpretation"},
        {"metric": "nlp_unique_token_ratio", "min": 42, "delta": 1, "reason": "lexical variety supports evidence texture"},
        {"metric": "nlp_evidence_marker_count", "min": 2, "delta": 1, "reason": "explicit evidence language present"},
        {"metric": "nlp_claim_evidence_coverage", "min": 60, "delta": 1, "reason": "evidence keeps pace with claims"}
      ],
      "category_penalties": {
        "evidence": 1,
        "readability": 1,
        "structure": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 760,
          "nlp_unique_token_ratio": 56
        }
      }
    },
    "clarity and coherence": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "avg_sentence_length", "min": 10, "max": 20, "delta": 1, "reason": "academic argument readability band"},
        {"metric": "nlp_readability_grade", "max": 10, "delta": 1, "reason": "reader-legible argument flow"},
        {"metric": "nlp_coref_ambiguity_count", "max": 1, "delta": 1, "reason": "referent chain stays stable"},
        {"metric": "nlp_coref_ambiguity_count", "min": 3, "delta": -1, "reason": "referent ambiguity interrupts coherence"}
      ],
      "category_penalties": {
        "clarity": 1,
        "readability": 1,
        "referent clarity": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 720
        },
        "max_metrics": {
          "avg_sentence_length": 16,
          "nlp_passive_sentences": 0
        }
      }
    },
    "sentence economy": {
      "base_score": 3,
      "finding_penalty": 2,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "avg_sentence_length", "max": 19, "delta": 1, "reason": "controlled scholarly sentence length"},
        {"metric": "adverb_count", "max": 6, "delta": 1, "reason": "modifier discipline in claims"},
        {"metric": "nlp_semantic_repetition_ratio", "max": 35, "delta": 1, "reason": "limited semantic redundancy"},
        {"metric": "nlp_semantic_repetition_ratio", "min": 60, "delta": -1, "reason": "semantic repetition lowers information density"}
      ],
      "category_penalties": {
        "sentence control": 1,
        "readability": 1,
        "prose precision": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 850,
          "nlp_unique_token_ratio": 56
        },
        "max_metrics": {
          "avg_sentence_length": 15,
          "adverb_count": 4
        }
      }
    }
  },
  "track_overrides": {}
}
