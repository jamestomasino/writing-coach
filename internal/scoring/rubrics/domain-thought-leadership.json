{
  "id": "domain-thought-leadership",
  "version": "det-v1",
  "domain": "thought_leadership",
  "default_skills": ["claim clarity", "structural signposting", "insight density", "authority and voice", "sentence economy"],
  "default_skill_config": {
    "base_score": 3,
    "finding_penalty": 3,
    "max_finding_penalty": 2,
    "no_finding_bonus": 1,
    "range_rules": [
      {"metric": "word_count", "min": 320, "delta": 1, "reason": "idea development depth"},
      {"metric": "avg_sentence_length", "min": 9, "max": 23, "delta": 1, "reason": "controlled argument cadence"}
    ],
    "category_penalties": {
      "clarity": 1,
      "readability": 1,
      "sentence control": 1,
      "structure": 1
    },
    "top_score_gate": {
      "require_no_findings": true,
      "min_metrics": {
        "word_count": 700,
        "nlp_unique_token_ratio": 56
      },
      "max_metrics": {
        "avg_sentence_length": 18,
        "nlp_readability_grade": 9,
        "nlp_passive_sentences": 0
      }
    }
  },
  "skills": {
    "claim clarity": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "nlp_claim_evidence_coverage", "min": 60, "delta": 1, "reason": "claims are paired with support"},
        {"metric": "nlp_claim_evidence_coverage", "max": 35, "delta": -1, "reason": "claims outpace evidence support"},
        {"metric": "nlp_coref_ambiguity_count", "max": 1, "delta": 1, "reason": "claim referents stay stable"}
      ],
      "category_penalties": {
        "clarity": 1,
        "causal clarity": 1,
        "referent clarity": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 720,
          "nlp_claim_evidence_coverage": 70
        },
        "max_metrics": {
          "nlp_coref_ambiguity_count": 1
        }
      }
    },
    "structural signposting": {
      "base_score": 3,
      "finding_penalty": 3,
      "max_finding_penalty": 2,
      "no_finding_bonus": 0,
      "range_rules": [
        {"metric": "paragraph_count", "min": 4, "delta": 1, "reason": "section-level structure visible"},
        {"metric": "nlp_long_sentences", "max": 2, "delta": 1, "reason": "reduced structural drag"},
        {"metric": "nlp_topic_drift_score", "max": 45, "delta": 1, "reason": "idea progression stays cohesive"},
        {"metric": "nlp_topic_drift_score", "min": 70, "delta": -1, "reason": "topic drift weakens structure"}
      ],
      "category_penalties": {
        "structure": 1,
        "clarity": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "paragraph_count": 8
        },
        "max_metrics": {
          "nlp_long_sentences": 0
        }
      }
    },
    "insight density": {
      "base_score": 3,
      "finding_penalty": 4,
      "max_finding_penalty": 2,
      "no_finding_bonus": 0,
      "range_rules": [
        {"metric": "nlp_unique_token_ratio", "min": 45, "delta": 1, "reason": "high lexical novelty signal"},
        {"metric": "word_count", "min": 380, "delta": 1, "reason": "room for original distinctions"}
      ],
      "category_penalties": {
        "diction variety": 1,
        "readability": 1
      },
      "top_score_gate": {
        "require_no_findings": true,
        "min_metrics": {
          "word_count": 760,
          "nlp_unique_token_ratio": 58
        },
        "max_metrics": {
          "nlp_readability_grade": 8
        }
      }
    },
    "sentence economy": {
      "base_score": 3,
      "finding_penalty": 2,
      "max_finding_penalty": 2,
      "no_finding_bonus": 1,
      "range_rules": [
        {"metric": "avg_sentence_length", "max": 19, "delta": 1, "reason": "argument units stay compact"},
        {"metric": "nlp_semantic_repetition_ratio", "max": 35, "delta": 1, "reason": "limited semantic redundancy"},
        {"metric": "nlp_semantic_repetition_ratio", "min": 60, "delta": -1, "reason": "repetition lowers insight density"}
      ],
      "category_penalties": {
        "sentence control": 1,
        "readability": 1,
        "sentence economy": 1
      }
    }
  },
  "track_overrides": {
    "journalism-reporting-track": {
      "add_skills": ["evidence integration"],
      "remove_skills": [],
      "skill_adjustments": {"structural signposting": 1}
    }
  }
}
