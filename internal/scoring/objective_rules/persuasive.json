  "rule_sets": [
    {
      "rule_id": "objective.persuasive.actionability",
      "domain": "thought_leadership",
      "track_slugs": ["persuasive-writing-track"],
      "tgo_codes": [
        "persuasive-action-target",
        "persuasive-call-to-action",
        "persuasive-campaign-thinking",
        "persuasive-conclusion"
      ],
      "metric_rules": [
        {
          "id": "objective.persuasive.actionability.action-density-high",
          "metric": "nlp_action_verb_density",
          "min": 7,
          "delta": 1,
          "reason": "actionability reward: explicit action language"
        },
        {
          "id": "objective.persuasive.actionability.action-density-low",
          "metric": "nlp_action_verb_density",
          "max": 2,
          "delta": -1,
          "reason": "actionability penalty: weak action language"
        },
        {
          "id": "objective.persuasive.actionability.temporal-clarity-high",
          "metric": "nlp_temporal_clarity_score",
          "min": 70,
          "delta": 1,
          "reason": "actionability reward: timing and urgency are explicit"
        },
        {
          "id": "objective.persuasive.actionability.temporal-clarity-low",
          "metric": "nlp_temporal_clarity_score",
          "max": 45,
          "delta": -1,
          "reason": "actionability penalty: timing is unclear"
        }
      ],
      "category_rules": [
        {
          "id": "objective.persuasive.actionability.clarity-overload",
          "category": "clarity",
          "max_hits": 1,
          "delta": -1,
          "reason": "actionability penalty: clarity findings"
        }
      ],
      "top_score_gate": {
        "require_rule_trigger_count": 1,
        "min_metrics": {
          "nlp_action_verb_density": 5
        },
        "max_metrics": {
          "nlp_topic_drift_score": 55
        }
      },
      "evidence_labels": ["actionability", "ask", "next-step"]
    },
