{
  "version": "obj-manifest-v1",
  "rule_sets": [
    {
      "rule_id": "objective.academic.claim-architecture",
      "domain": "academic",
      "track_slugs": ["academic-essay-track"],
      "tgo_codes": [
        "academic-thesis-clarity",
        "academic-scope-control",
        "academic-claim-ladder",
        "academic-stakes-articulation",
        "academic-introduction-function",
        "academic-conclusion-function",
        "academic-title-framing",
        "academic-abstract-writing",
        "academic-oral-defense",
        "academic-final-resonance",
        "academic-independent-voice"
      ],
      "metric_rules": [
        {
          "id": "objective.academic.claim-architecture.coverage-strong",
          "metric": "nlp_claim_evidence_coverage",
          "min": 60,
          "delta": 1,
          "reason": "claim architecture reward: claims are matched with support"
        },
        {
          "id": "objective.academic.claim-architecture.coverage-weak",
          "metric": "nlp_claim_evidence_coverage",
          "max": 35,
          "delta": -1,
          "reason": "claim architecture penalty: claims outrun support"
        },
        {
          "id": "objective.academic.claim-architecture.claim-volume-low",
          "metric": "nlp_claim_count",
          "max": 1,
          "delta": -1,
          "reason": "claim architecture penalty: too few explicit claims"
        },
        {
          "id": "objective.academic.claim-architecture.topic-drift",
          "metric": "nlp_topic_drift_score",
          "min": 70,
          "delta": -1,
          "reason": "claim architecture penalty: topic drift weakens line of argument"
        }
      ],
      "category_rules": [
        {
          "id": "objective.academic.claim-architecture.clarity-overload",
          "category": "clarity",
          "max_hits": 1,
          "delta": -1,
          "reason": "claim architecture penalty: clarity findings"
        },
        {
          "id": "objective.academic.claim-architecture.development-overload",
          "category": "development",
          "max_hits": 1,
          "delta": -1,
          "reason": "claim architecture penalty: development findings"
        }
      ],
      "top_score_gate": {
        "require_rule_trigger_count": 1,
        "min_metrics": {
          "word_count": 650
        },
        "max_metrics": {
          "nlp_topic_drift_score": 45
        }
      },
      "evidence_labels": ["claim", "architecture", "argument"]
    },
