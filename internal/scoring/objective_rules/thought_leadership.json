    {
      "rule_id": "objective.thought-leadership.actionability",
      "domain": "thought_leadership",
      "track_slugs": ["thought-leadership-track"],
      "tgo_codes": ["actionable-insight"],
      "metric_rules": [
        {
          "id": "objective.thought-leadership.actionability.action-density-high",
          "metric": "nlp_action_verb_density",
          "min": 7,
          "delta": 1,
          "reason": "actionability reward: insight translates to concrete moves"
        },
        {
          "id": "objective.thought-leadership.actionability.action-density-low",
          "metric": "nlp_action_verb_density",
          "max": 2,
          "delta": -1,
          "reason": "actionability penalty: insight remains abstract"
        }
      ],
      "category_rules": [],
      "top_score_gate": {
        "require_rule_trigger_count": 1,
        "min_metrics": {
          "nlp_action_verb_density": 5
        },
        "max_metrics": {
          "nlp_topic_drift_score": 55
        }
      },
      "evidence_labels": ["actionability", "application", "next-move"]
    },
