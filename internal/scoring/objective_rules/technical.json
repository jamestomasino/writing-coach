{
  "version": "obj-manifest-v1",
  "rule_sets": [
    {
      "rule_id": "objective.technical.actionability",
      "domain": "technical",
      "track_slugs": ["technical-writing-track"],
      "tgo_codes": [
        "technical-prereq-clarity",
        "technical-remediation-order",
        "technical-result-visibility",
        "technical-sequence-control",
        "technical-step-clarity"
      ],
      "metric_rules": [
        {
          "id": "objective.technical.actionability.action-density-high",
          "metric": "nlp_action_verb_density",
          "min": 8,
          "delta": 1,
          "reason": "actionability reward: action-verb density supports execution"
        },
        {
          "id": "objective.technical.actionability.action-density-low",
          "metric": "nlp_action_verb_density",
          "max": 3,
          "delta": -1,
          "reason": "actionability penalty: low action-verb density"
        },
        {
          "id": "objective.technical.actionability.reference-specificity-high",
          "metric": "nlp_reference_specificity_score",
          "min": 65,
          "delta": 1,
          "reason": "actionability reward: references are specific"
        }
      ],
      "category_rules": [
        {
          "id": "objective.technical.actionability.clarity-overload",
          "category": "clarity",
          "max_hits": 1,
          "delta": -1,
          "reason": "actionability penalty: clarity findings"
        }
      ],
      "top_score_gate": {
        "require_rule_trigger_count": 1,
        "min_metrics": {
          "nlp_action_verb_density": 6
        },
        "max_metrics": {
          "nlp_topic_drift_score": 50
        }
      },
      "evidence_labels": ["actionability", "execution", "steps"]
    },
