    {
      "rule_id": "objective.professional.actionability",
      "domain": "professional",
      "track_slugs": ["professional-writing-track"],
      "tgo_codes": [
        "ask-visibility",
        "deadline-clarity",
        "decision-framing",
        "decision-language",
        "document-closings",
        "ownership-clarity",
        "proof-of-action"
      ],
      "metric_rules": [
        {
          "id": "objective.professional.actionability.action-density-high",
          "metric": "nlp_action_verb_density",
          "min": 7,
          "delta": 1,
          "reason": "actionability reward: request language is directive"
        },
        {
          "id": "objective.professional.actionability.action-density-low",
          "metric": "nlp_action_verb_density",
          "max": 2,
          "delta": -1,
          "reason": "actionability penalty: action language is too weak"
        },
        {
          "id": "objective.professional.actionability.temporal-clarity-high",
          "metric": "nlp_temporal_clarity_score",
          "min": 70,
          "delta": 1,
          "reason": "actionability reward: timing is explicit"
        },
        {
          "id": "objective.professional.actionability.temporal-clarity-low",
          "metric": "nlp_temporal_clarity_score",
          "max": 45,
          "delta": -1,
          "reason": "actionability penalty: timing and urgency are unclear"
        }
      ],
      "category_rules": [
        {
          "id": "objective.professional.actionability.clarity-overload",
          "category": "clarity",
          "max_hits": 1,
          "delta": -1,
          "reason": "actionability penalty: clarity findings"
        }
      ],
      "top_score_gate": {
        "require_rule_trigger_count": 1,
        "min_metrics": {
          "nlp_action_verb_density": 5
        },
        "max_metrics": {
          "nlp_topic_drift_score": 50
        }
      },
      "evidence_labels": ["actionability", "ask", "next-step"]
    },
