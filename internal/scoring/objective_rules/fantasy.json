{
  "version": "obj-manifest-v1",
  "rule_sets": [
    {
      "rule_id": "objective.fantasy-story.audience-alignment",
      "domain": "fantasy",
      "track_slugs": [
        "fantasy-fiction-track"
      ],
      "tgo_codes": [
        "fantasy-story-beta-awareness"
      ],
      "metric_rules": [
        {
          "id": "objective.fantasy-story.audience-alignment.reference-high",
          "metric": "nlp_reference_specificity_score",
          "min": 65,
          "delta": 1,
          "reason": "audience alignment reward: audience cues are concrete"
        },
        {
          "id": "objective.fantasy-story.audience-alignment.reference-low",
          "metric": "nlp_reference_specificity_score",
          "max": 45,
          "delta": -1,
          "reason": "audience alignment penalty: audience cues are vague"
        },
        {
          "id": "objective.fantasy-story.audience-alignment.drift-high",
          "metric": "nlp_topic_drift_score",
          "min": 60,
          "delta": -1,
          "reason": "audience alignment penalty: reader focus drifts"
        }
      ],
      "category_rules": [],
      "top_score_gate": {
        "require_rule_trigger_count": 1,
        "min_metrics": {
          "nlp_reference_specificity_score": 60
        },
        "max_metrics": {
          "nlp_topic_drift_score": 55
        }
      },
      "evidence_labels": [
        "audience-alignment",
        "fiction",
        "storycraft"
      ]
    },
